{
  "paths": {
    "dataset": "data/raw/aptos",
    "splits": "data/splits",
    "model": "artifacts/models/best_model.keras",
    "model_metadata": "artifacts/models/metadata.json",
    "calibration": "artifacts/models/calibration.json",
    "evaluation": "artifacts/evaluation",
    "reports": "artifacts/reports",
    "database": "instance/retina_triage.sqlite3"
  },
  "dataset": {
    "adapter": "aptos",
    "image_column": "id_code",
    "label_column": "diagnosis",
    "train_fraction": 0.70,
    "validation_fraction": 0.15,
    "test_fraction": 0.15
  },
  "random_seed": 42,
  "image_size": 224,
  "preprocessing": {
    "clahe": false,
    "min_dimension": 64,
    "black_threshold": 10
  },
  "quality": {
    "minimum_score": 0.75,
    "min_width": 224,
    "min_height": 224,
    "min_blur": 18.0,
    "min_brightness": 22.0,
    "max_brightness": 235.0,
    "max_underexposed_ratio": 0.65,
    "max_overexposed_ratio": 0.35,
    "min_contrast": 18.0,
    "min_field_coverage": 0.28
  },
  "augmentation": {
    "horizontal_flip": true,
    "rotation": 0.06,
    "zoom": 0.08,
    "translation": 0.06,
    "contrast": 0.10
  },
  "model": {
    "backbone": "EfficientNetB0",
    "dropout": 0.40,
    "dense_units": 256,
    "dense_dropout": 0.30,
    "version": "untrained"
  },
  "stage_one": {"epochs": 15, "batch_size": 24, "learning_rate": 0.001, "patience": 4},
  "stage_two": {"epochs": 20, "learning_rate": 0.00001, "unfreeze_layers": 40, "patience": 5},
  "loss": {"name": "categorical_crossentropy", "label_smoothing": 0.05, "focal_gamma": 2.0},
  "calibration": {"temperature": 1.0, "target_referable_sensitivity": 0.90, "target_high_risk_sensitivity": 0.90},
  "triage": {
    "low_confidence": 0.60,
    "high_entropy": 1.25,
    "low_margin": 0.15,
    "referable_probability": 0.50,
    "high_risk_probability": 0.35
  },
  "uploads": {
    "allowed_extensions": ["jpg", "jpeg", "png"],
    "max_file_mb": 12,
    "max_batch_files": 20
  },
  "retention": {"store_originals": false, "report_days": 30},
  "database": {"timeout_seconds": 10},
  "reports": {"format": "pdf"},
  "logging": {"level": "INFO"},
  "demo_mode": {"enabled": false}
}
